{
  "name": "@skynet/runner-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./claude": {
      "types": "./dist/claude.d.ts",
      "default": "./dist/claude.js"
    },
    "./codex": {
      "types": "./dist/codex.d.ts",
      "default": "./dist/codex.js"
    },
    "./gemini": {
      "types": "./dist/gemini.d.ts",
      "default": "./dist/gemini.js"
    },
    "./cursor": {
      "types": "./dist/cursor.d.ts",
      "default": "./dist/cursor.js"
    },
    "./copilot": {
      "types": "./dist/copilot.d.ts",
      "default": "./dist/copilot.js"
    },
    "./hermes": {
      "types": "./dist/hermes.d.ts",
      "default": "./dist/hermes.js"
    },
    "./sandbox": {
      "types": "./dist/sandbox.d.ts",
      "default": "./dist/sandbox.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.179",
    "@skynet/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3"
  }
}
