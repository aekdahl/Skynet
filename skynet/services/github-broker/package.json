{
  "name": "@skynet/github-broker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stateless GCP gen-2 function: mints short-lived GitHub App installation tokens for authorized users.",
  "main": "index.mjs",
  "scripts": {
    "start": "functions-framework --target=token",
    "deploy": "gcloud functions deploy github-token-broker --gen2 --region=${REGION:-europe-west1} --runtime=nodejs20 --trigger-http --entry-point=token --allow-unauthenticated --max-instances=5 --set-secrets=GITHUB_APP_ID=github-app-id:latest,GITHUB_APP_PRIVATE_KEY=github-app-private-key:latest"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.4.0"
  }
}
