#!/usr/bin/env bash
# Skynet VM startup (Debian 12). Mounts the data disk, installs Docker, fetches
# secrets from Secret Manager via the VM's service account, and runs the headless
# Skynet server. Re-runs safely on reboot. (Terraform template vars are the plain
# dollar-brace form; shell vars are written with a doubled dollar so Terraform
# leaves them literal.)
set -euo pipefail
exec > >(tee -a /var/log/skynet-startup.log) 2>&1
echo "[skynet] startup $(date -u)"

# ── 1. Data disk → /data (format only if brand new; never reformat) ──────────
DEV=/dev/disk/by-id/google-skynet-data
mkdir -p /data
if ! blkid "$${DEV}" >/dev/null 2>&1; then
  echo "[skynet] formatting new data disk"
  mkfs.ext4 -m 0 -F -E lazy_itable_init=0,lazy_journal_init=0,discard "$${DEV}"
fi
grep -q "/data" /etc/fstab || echo "$${DEV} /data ext4 discard,defaults,nofail 0 2" >>/etc/fstab
mount -a
# Grow the filesystem to fill the disk (idempotent, online) so bumping
# data_disk_gb and redeploying actually enlarges /data instead of leaving the
# extra space unused.
resize2fs "$${DEV}" 2>/dev/null || true
# All heavy, unbounded churn lives on the DATA disk, never the small boot disk:
# agent worktrees, cloned repos, and preview `npm install`s (100s of MB each).
# The boot disk holds the OS + Docker's overlay — filling it wedges the whole VM.
mkdir -p /data /data/worktrees /data/repos /data/.npm

# ── 1b. Swap — headroom so a memory spike (a heavy agent or a preview build) on a
#      small VM (e2-small = 2GB) spills to swap instead of OOM-killing the HOST
#      (which takes the whole site down). Idempotent across reboots. ───────────
if [ ! -f /swapfile ]; then
  echo "[skynet] creating 2G swapfile"
  fallocate -l 2G /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
fi
swapon /swapfile 2>/dev/null || true
grep -q "/swapfile" /etc/fstab || echo "/swapfile none swap sw 0 0" >>/etc/fstab

# ── 2. Docker ────────────────────────────────────────────────────────────────
if ! command -v docker >/dev/null 2>&1; then
  echo "[skynet] installing docker"
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -y
  apt-get install -y docker.io curl python3
  systemctl enable --now docker
fi

# ── 3. Access token + secret helper (Secret Manager REST via metadata SA) ────
TOKEN=$(curl -s -H "Metadata-Flavor: Google" \
  "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token" \
  | python3 -c 'import sys,json;print(json.load(sys.stdin)["access_token"])')

get_secret() { # $1 = short name; prints value, empty if not set
  curl -s -H "Authorization: Bearer $${TOKEN}" \
    "https://secretmanager.googleapis.com/v1/projects/${project_id}/secrets/${name_prefix}-$${1}/versions/latest:access" \
    | python3 -c 'import sys,json,base64
try:
  d=json.load(sys.stdin); sys.stdout.write(base64.b64decode(d["payload"]["data"]).decode())
except Exception:
  pass'
}

ANTHROPIC_API_KEY=$(get_secret anthropic-api-key)
TG_TOKEN=$(get_secret telegram-bot-token)
TG_CHAT=$(get_secret telegram-owner-chat-id)
ADMIN_PASSWORD=$(get_secret admin-password)
GITHUB_TOKEN=$(get_secret github-token)
%{ if enable_mcp_https ~}
# Public /mcp door: the Bearer credential clients present. Fail loudly if unset
# rather than serving an endpoint that rejects every request.
MCP_TOKEN=$(get_secret mcp-token)
if [ -z "$${MCP_TOKEN}" ]; then
  echo "[skynet] FATAL: enable_mcp_https but secret ${name_prefix}-mcp-token has no value — add one with 'gcloud secrets versions add ${name_prefix}-mcp-token', then reboot." >&2
  exit 1
fi
%{ endif ~}

# Master key: prefer the secret; else persist a generated one on /data (stable
# across reboots) so file-store encryption keeps working.
MASTER_KEY=$(get_secret master-key)
if [ -z "$${MASTER_KEY}" ]; then
  if [ ! -f /data/master.key ]; then openssl rand -base64 32 >/data/master.key; chmod 600 /data/master.key; fi
  MASTER_KEY=$(cat /data/master.key)
fi

# ── 4. Env file (tmpfs, 0600) ────────────────────────────────────────────────
ENVF=/run/skynet.env
umask 077
cat >"$${ENVF}" <<EOF
NODE_ENV=production
AUTH_REQUIRED=true
# Single-node self-host: durable data on the /data disk (STORE=file); the bus
# stays in-process (no multi-replica fan-out on one VM).
STORE=file
BUS=memory
%{ if durable_sessions ~}
# Sessions live in the Redis sidecar (AOF-persisted on /data/redis) so the app
# container's restarts — its DESIGNED recovery path (memory cap → OOM-kill →
# --restart=always) — no longer log everyone out. See the sidecar run below.
SESSIONS=redis
REDIS_URL=redis://skynet-redis:6379
%{ else ~}
# NB: SESSIONS=memory means a restart logs you out (re-login) — data itself
# stays on /data. Set durable_sessions=true for the Redis sidecar instead.
SESSIONS=memory
%{ endif ~}
SKYNET_DB_PATH=/data/skynet-data.json
# Keep agent worktrees, cloned repos, and preview node_modules + npm cache on the
# DATA disk — NOT the container's writable layer on the small boot disk, where
# unbounded growth fills the disk and wedges the whole VM. (/tmp is also bind-
# mounted to /data/tmp below, and the npm cache is set via npm_config_cache.)
SKYNET_WORKTREES_DIR=/data/worktrees
SKYNET_REPOS_DIR=/data/repos
npm_config_cache=/data/.npm
SKYNET_MASTER_KEY=$${MASTER_KEY}
PORT=${app_port}
SKYNET_ADMIN_EMAIL=${admin_email}
SKYNET_ADMIN_PASSWORD=$${ADMIN_PASSWORD}
SKYNET_ADMIN_WORKSPACE=${admin_workspace}
ANTHROPIC_API_KEY=$${ANTHROPIC_API_KEY}
SKYNET_TELEGRAM_BOT_TOKEN=$${TG_TOKEN}
SKYNET_TELEGRAM_OWNER_CHAT_ID=$${TG_CHAT}
SKYNET_TELEGRAM_CONTROL=${telegram_control}
GITHUB_TOKEN=$${GITHUB_TOKEN}
%{ if caddy_enabled ~}
# Behind Caddy: trust X-Forwarded-For so per-IP rate limiting keys on the real caller.
SKYNET_TRUST_PROXY=true
%{ endif ~}
%{ if public_ui ~}
# Public UI (no IAP): require a Telegram OTP second factor on login. Recovery
# codes are written to /data/mfa-recovery-codes.txt on first boot (retrieve over
# SSH). Break-glass if you lose Telegram AND the codes: set SKYNET_MFA_DISABLE=1
# here + reboot to log in with password only.
SKYNET_MFA=true
%{ endif ~}
%{ if enable_mcp_https ~}
# Narrow /mcp door only: register the injected token as a scoped bootstrap
# service token. (public_ui uses a service token minted in Settings instead.)
SKYNET_BOOTSTRAP_TOKEN=$${MCP_TOKEN}
SKYNET_BOOTSTRAP_SCOPES=${mcp_scopes}
%{ endif ~}
EOF

# ── 5. Pull + run the app ────────────────────────────────────────────────────
echo "$${TOKEN}" | docker login -u oauth2accesstoken --password-stdin "https://${region}-docker.pkg.dev"
# Reclaim boot-disk space BEFORE pulling: drop dangling layers left by previous
# :latest pulls. They accumulate on the 20 GB boot disk and, once it's full, the
# pull below fails — so prune first to recover an already-full box. (Dangling
# only: the tagged skynet/caddy images stay, so no needless re-pull.)
docker image prune -f >/dev/null 2>&1 || true
docker pull "${image}"
docker rm -f skynet >/dev/null 2>&1 || true
# Agent scratch (npm/builds/tmp) goes on the big /data disk, not the boot overlay:
# bind /tmp → /data/tmp (cleared each boot for fresh-/tmp semantics) + npm cache
# on /data (env file). This is what keeps root from filling under agent load.
mkdir -p /data/tmp /data/.npm && rm -rf /data/tmp/* 2>/dev/null || true
%{ if durable_sessions ~}
# ── 5a. Redis sidecar: durable login sessions ────────────────────────────────
# Sessions only — tiny writes, AOF-persisted on the data disk so they survive
# app-container restarts AND VM reboots. A user-defined network gives the app
# name-based DNS to reach it (the default bridge has none); the port is never
# published to the host. `noeviction` + a small cap: a session must never be
# silently dropped under memory pressure, and the cap keeps any runaway inside
# the host reserve accounted for below.
docker network create skynet-net >/dev/null 2>&1 || true
mkdir -p /data/redis
docker rm -f skynet-redis >/dev/null 2>&1 || true
docker run -d --restart=always --name skynet-redis \
  --network skynet-net \
  -v /data/redis:/data \
  --memory=96m \
  --log-driver json-file --log-opt max-size=5m --log-opt max-file=2 \
  redis:7-alpine redis-server --appendonly yes --maxmemory 64mb --maxmemory-policy noeviction
%{ endif ~}
# Memory cap: reserve headroom for the OS + dockerd + Caddy (+ the Redis
# sidecar's own 96m cap when enabled) so an app/agent memory blowup OOM-kills
# the CONTAINER — which --restart=always recovers, so the site self-heals —
# instead of the HOST, which goes unreachable and no restart policy can bring
# back. --memory-swap lets it burst into the swapfile before the kill.
%{ if durable_sessions ~}
HOST_RESERVE_MB=608
%{ else ~}
HOST_RESERVE_MB=512
%{ endif ~}
MEM_TOTAL_MB=$(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo)
MEM_LIMIT_MB=$(( MEM_TOTAL_MB > 1024 ? MEM_TOTAL_MB - HOST_RESERVE_MB : 512 ))
MEM_SWAP_MB=$(( MEM_LIMIT_MB + 2048 ))
# CPU cap: reserve half a core for the OS + dockerd + Caddy so an agent/build
# pegging the CPU can't starve the host into unresponsiveness (on a shared-core
# e2-small, a saturated CPU makes the VM drop connections — it looks "down").
# The app + agents share the rest. Floors at 0.5 on a 1-vCPU box.
CPU_LIMIT=$(nproc | awk '{c=$1-0.5; print (c<0.5?0.5:c)}')
# Log rotation: default json-file logs grow UNBOUNDED and fill the boot disk (a
# top cause of a wedged VM). Cap them.
docker run -d --restart=always --name skynet \
%{ if durable_sessions ~}
  --network skynet-net \
%{ endif ~}
  -p ${app_port}:${app_port} \
  --env-file "$${ENVF}" \
  -v /data:/data \
  -v /data/tmp:/tmp \
  --memory="$${MEM_LIMIT_MB}m" --memory-swap="$${MEM_SWAP_MB}m" --cpus="$${CPU_LIMIT}" \
  --log-driver json-file --log-opt max-size=10m --log-opt max-file=5 \
  "${image}"
echo "[skynet] up on :${app_port} (mem cap $${MEM_LIMIT_MB}m + swap, cpus $${CPU_LIMIT})"
%{ if caddy_enabled ~}

# ── 6. Caddy on the host network terminates TLS on :443 (Let's Encrypt) and
#      reverse-proxies to the app at 127.0.0.1:${app_port} (host-published
#      above). Narrow mode serves only /mcp; public_ui serves the whole app. ──
mkdir -p /data/caddy
cat >/data/Caddyfile <<'CADDYEOF'
${caddyfile}
CADDYEOF
docker rm -f caddy >/dev/null 2>&1 || true
# A SIGKILL'd Caddy (docker rm -f, or a reboot mid-issuance) can leave a stale
# ACME storage lock that a fresh Caddy then blocks on — wedged with no cert
# (accepts TCP on :443 but never completes TLS). Clear stale locks before start.
rm -rf /data/caddy/locks 2>/dev/null || true
docker run -d --restart=always --name caddy \
  --network host \
  -v /data/Caddyfile:/etc/caddy/Caddyfile:ro \
  -v /data/caddy:/data \
  --log-driver json-file --log-opt max-size=10m --log-opt max-file=3 \
  caddy:2
echo "[skynet] Caddy up on :443 — https://${mcp_domain}"
%{ endif ~}

# Reclaim boot-disk space. Every :latest re-pull leaves the previous image
# behind, and those pile up on the small (20 GB) boot disk until it fills — which
# wedges Caddy and breaks the next pull. Drop images not used by a running
# container (the live skynet + caddy images are kept; bind-mounted /data is never
# touched). Runs after the containers are up, so it only removes truly-stale layers.
docker image prune -af >/dev/null 2>&1 || true
echo "[skynet] boot disk after prune: $(df -h / | awk 'NR==2{print $4" free of "$2}')"
