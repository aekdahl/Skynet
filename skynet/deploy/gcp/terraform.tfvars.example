# Copy to terraform.tfvars and fill in. No secret VALUES go here — those live in
# Secret Manager (setup.sh prints the commands). This file is git-ignored.

project_id     = "your-gcp-project-id"
region         = "europe-west1"
zone           = "europe-west1-b" # NB: europe-west1 has no -a zone (b/c/d only)
machine_type   = "e2-small" # bump to e2-medium / e2-standard-2 for heavier builds
app_port       = 8080                 # remote: port the app listens on inside the VM
local_port     = 48080                # local: port the IAP tunnel binds on your machine (uncommon, avoids conflicts)
data_disk_gb   = 20
operator_email = "you@example.com"    # your Google account — gets IAP tunnel access
admin_email    = "you@example.com"    # seed login for the Skynet web UI
admin_workspace = "skynet"
telegram_control = false              # true = allow approve/create/etc. over Telegram (kill switch always works)
# name_prefix  = "skynet"             # prefix for created resource names
