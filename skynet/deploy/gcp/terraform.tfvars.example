# Copy to terraform.tfvars and fill in. No secret VALUES go here — those live in
# Secret Manager (setup.sh prints the commands). This file is git-ignored.

project_id     = "your-gcp-project-id"
region         = "europe-west1"
zone           = "europe-west1-b" # NB: europe-west1 has no -a zone (b/c/d only)
machine_type   = "e2-standard-2" # 2 dedicated vCPU / 8GB — a few agents + a live-preview build. If it struggles, cap the workspace maxRunners (3-4 here) BEFORE sizing up to e2-standard-4: overload is nearly always concurrency, not size.
app_port       = 8080                 # remote: port the app listens on inside the VM
local_port     = 48080                # local: port the IAP tunnel binds on your machine (uncommon, avoids conflicts)
data_disk_gb   = 20
operator_email = "you@example.com"    # your Google account — gets IAP tunnel access
admin_email    = "you@example.com"    # seed login for the Skynet web UI
admin_workspace = "skynet"
telegram_control = false              # true = allow approve/create/etc. over Telegram (kill switch always works)
# name_prefix  = "skynet"             # prefix for created resource names

# ── Optional: a public HTTPS /mcp door for agents (keeps IAP for the human UI) ─
# Off by default → IAP-only (unchanged). Turn on to let a non-browser client
# (e.g. a Cloud Run agent that can't use the tunnel) reach /mcp. Same box, same
# data disk, in-place apply. Point mcp_domain's A-record at the `mcp_vm_ip`
# output BEFORE apply, and add the skynet-mcp-token secret (the Bearer value).
# enable_mcp_https          = true
# mcp_domain                = "mcp.example.com"    # DNS → the reserved static IP (mcp_vm_ip output)
# acme_email                = "you@example.com"    # Let's Encrypt account email
# mcp_allowed_source_ranges = ["203.0.113.7/32"]   # your MCP client egress IP(s); never 0.0.0.0/0
# mcp_scopes                = "observe,author"      # add "approver" only to self-resolve HITL gates
# open_acme_http            = true                  # :80 for ACME HTTP-01 (false = use DNS-01)

# ── Optional: serve the WHOLE app publicly (public_ui) — drops IAP for the UI ──
# Instead of the narrow /mcp door above, expose the whole app over HTTPS at
# mcp_domain: UI gated by the app login (+ MFA), /mcp by a Bearer service token
# minted in Settings. Opens :443/:80 to the internet; keeps IAP for SSH only.
# Pre-reserve the static IP first:  gcloud compute addresses create skynet-public-ip --region=<region>
# then point mcp_domain's A-record at it BEFORE apply. Mutually exclusive with enable_mcp_https.
# public_ui  = true
# mcp_domain = "skynet.example.com"   # A-record → the skynet-public-ip address
# acme_email = "you@example.com"      # Let's Encrypt account email
# open_acme_http = true               # :80 for ACME HTTP-01
