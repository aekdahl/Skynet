# ─── Skynet environment ───────────────────────────────────────────────
# Copy to .env and fill in. Self-host: `docker compose up` reads this.

# Server
PORT=8080
NODE_ENV=development

# Persistence — Phase 0 ships an in-memory store seeded from fixtures.
# Set STORE=postgres + DATABASE_URL to use the Postgres adapter (compose provides it).
STORE=memory
DATABASE_URL=postgres://skynet:skynet@localhost:5432/skynet

# Real-time fan-out — in-process bus by default; set BUS=redis to fan out
# across multiple app replicas (compose provides Redis).
BUS=memory
REDIS_URL=redis://localhost:6379

# Orchestration — Phase 0 runs a mock runner (canned plan + simulated log),
# matching the prototype. RUNNER=claude uses the real Claude Agent SDK (needs
# agent credentials). SKYNET_RUNNER_CWD points a real runner at its working repo.
RUNNER=mock
# SKYNET_RUNNER_CWD=/path/to/target/repo

# Auth — when true, requests without a valid token are rejected (401). Off in
# dev so the local flow stays open (defaults to the 'cyberdyne' workspace).
# Dev tokens (always valid): dev-cyberdyne, dev-resistance.
AUTH_REQUIRED=false
# Real login: POST /api/auth/login {email,password} → session token + cookie.
# Dev seed credentials: jordan@cyberdyne.dev / kyle@resistance.dev (pw: skynet).
# Session lifetime in ms before a token expires → 401 (default 12h).
SESSION_TTL_MS=43200000

# Provider API keys (only needed once real runners land — Phase 1+)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Web (Vite) — base URL the SPA uses to reach the API/WS.
VITE_API_URL=http://localhost:8080
